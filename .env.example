# Copy to .env and fill in. .env is gitignored: it holds the panel PIN and any API or MQTT credentials. Never commit it.
# Everything is optional except where noted; the values shown are the defaults unless they are commented out.

# --- Server -------------------------------------------------------------------------
PORT=8080
# The panel downloads each picture from http://<this machine>:PORT. With nothing set, the machine's own LAN address is looked up
# every time a picture is pushed (so a laptop that changes network keeps working). Set PUBLIC_HOST when that finds the wrong one,
# which it does in Docker Desktop (the container cannot see your LAN address: set it to the computer's address on the panel's network).
# PUBLIC_HOST=192.168.1.50
# Or the full base URL when this runs behind a proxy or Ingress (overrides PUBLIC_HOST and PORT):
# PUBLIC_URL=https://birds.example.internal
TIMEZONE=America/New_York

# --- BirdNET-Go (required) -------------------------------------------------------------
BIRDNET_URL=http://192.168.1.10:8086
# BIRDNET_TOKEN=                # only for a reverse proxy that wants a bearer token
# A species is shown when heard this many times today, at least once at this confidence or better:
# MIN_DETECTIONS=2
# MIN_CONFIDENCE=0.6
# FALLBACK_DAYS=7               # nothing qualifies today: show the best of the last N days (0: show the quiet page)
# Detections that are not wildlife (BirdNET-Go and Perch also label people, engines, sirens...) are left off the page. Whole common or
# scientific names, lower case; setting this replaces the built-in list, which also holds domestic dogs and cats (remove them to paint them):
# EXCLUDE=human,human vocal,engine,siren,gun,fireworks,power tools,dog,domestic dog,domestic cat
# Frogs, mammals and insects (BirdNET-Go 3, Perch 2) are painted in their own way. Which kind of animal a species is comes from GBIF's
# name match: only the scientific name is sent, once per species, and the answer is kept in the plates folder. false: everything is a bird.
# TAXON_LOOKUP=true
# The footer's first words: "Backyard · heard to-day · Sun 22 Nov · 19 species"
GARDEN_NAME=Backyard

# --- Layout and style ------------------------------------------------------------------------
# cluster: the day's birds cut from their plates and grouped on one page, the most heard biggest and in the middle (default)
# scene:   the cluster as one picture, with a FLUX.2 pass painting the background around the birds (prototype)
# folio:   one bird per page as a full plate     specimen: six birds on one sheet
# Per display: DISPLAY_<ID>_LAYOUT. Home Assistant and POST /api/displays/<id>/layout?name= can switch it live.
LAYOUT=cluster
# MAX_BIRDS=16                  # cluster: how many birds
# SIZE_BY=calls                 # cluster: calls (most heard biggest, in the middle) | equal
# CLUSTER_PAPER=#ffffff         # cluster: the page colour (default: white, the panel's own white)
# The art style of the plates; each style keeps its own plates, so switching costs nothing after the first time:
#   gould       hand-coloured lithograph, engraved line work and washes (default)
#   audubon     watercolour plate
#   engraving   black-ink copperplate
#   woodblock   Japanese ukiyo-e print
#   midcentury  flat geometric shapes after Charley Harper
STYLE=gould

# --- FLUX.2 images ---------------------------------------------------------------------------
# comfyui: a ComfyUI server running FLUX.2 (the usual way FLUX.2 is served at home)
# openai:  a server with the OpenAI images API (POST /images/generations and /images/edits)
# none:    no painting; birds without a plate show as a faint oval
IMAGE_BACKEND=comfyui
COMFY_URL=http://192.168.1.20:8188
# COMFY_UNET=flux2_dev_fp8mixed.safetensors     # or flux-2-klein-base-9b.safetensors (then try IMAGE_STEPS=28)
# COMFY_CLIP=mistral_3_small_flux2_fp8.safetensors
# COMFY_VAE=flux2-vae.safetensors
# IMAGE_STEPS=20
# IMAGE_GUIDANCE=4
# openai:
# IMAGE_API_URL=http://192.168.1.20:8000/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=flux.2
# A plate is made in the background, one at a time, and kept for good (about 105 seconds each at 1024x1024 on a
# 20-step FLUX.2 dev; a new species is painted the first time it is heard). The picture is redrawn when it lands.
# PLATE_WIDTH=1024
# PLATE_HEIGHT=1024
# auto: repaint BirdNET-Go's reference photo (image editing, so the plumage is right), else paint from the name | edit | text
# PLATE_MODE=auto
# The most new plates made in a day (a failed painting is tried again after 6 hours):
# PLATES_PER_DAY=24
# IMAGE_TIMEOUT_SECONDS=600
# PLATE_DIR=/data/plates        # set by the image; where plates and cut-outs are kept

# --- Field notes (folio layout): a local OpenAI-compatible chat model writes a line under each bird -----
NOTES=false
# LLM_URL=http://192.168.1.20:8000/v1
# LLM_MODEL=                    # default: the first model the server lists
# LLM_API_KEY=

# --- When the panel is redrawn --------------------------------------------------------------
# auto (default): the birds are looked up every REFRESH_INTERVAL_SECONDS and the panel is redrawn when the picture changed (the
#                 order of the birds changes as the day goes on, so this can flash the panel often: lengthen the interval)
# manual:         only "redraw pending" is raised; POST /api/displays/<id>/refresh (or Home Assistant) sends it
REDRAW_MODE=auto
REFRESH_INTERVAL_SECONDS=1800
# In auto mode the panel is redrawn at least this often, even when nothing changed (seconds):
# FORCE_PUSH_SECONDS=86400
# STATE_FILE=/data/state.json   # set by the image; remembers what the panel shows across restarts

# --- The panel (Samsung EM32DX over MDC) ---------------------------------------------------
# With DISPLAY_HOST/PIN unset the server only renders and serves ("serve-only"): open http://<host>:PORT/ to see the page.
# DISPLAY_HOST=192.168.1.123
# DISPLAY_PIN=123456
# A panel on battery sleeps by itself; with its Wi-Fi MAC (and Network Standby turned on) it is woken before a push:
# DISPLAY_MAC=00:11:22:33:44:55
# MDC_PUSH_ENABLED=false         # master switch: false disables every push
# PANEL_WIDTH=1440
# PANEL_HEIGHT=2560
# OUTPUT_ROTATION=0
# ART_DITHER=panel               # panel | pattern | diffusion  (how the paper and plates reach the six inks)
# TEXT_AA=panel                  # panel | threshold | dither
# Several panels (DISPLAYS=a,b with DISPLAY_<ID>_HOST ...), waking and sleeping a battery panel (DISPLAY_SLEEP_AFTER_PUSH ...)
# and the rest of the display settings work as in the samsung-epaper-calendar project (src/config.mjs lists them).

# --- Home Assistant (MQTT) ---------------------------------------------------------------
# MQTT_URL=mqtt://192.168.1.10:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_DISCOVERY_PREFIX=homeassistant
# MQTT_TOPIC_PREFIX=samsung-epaper-birds
